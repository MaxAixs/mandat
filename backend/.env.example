# Copy to .env (git-ignored) before the first start. Dev-only default:
# the app reads it as DB_PASSWORD, the db service initializes PostgreSQL
# with it. Change it for anything beyond local development.
DB_PASSWORD=mandat

# Not used by the local Compose stack: its Redis has no password and Compose
# does not forward this variable to the app service. Keep it for deployments
# that run the app directly against a password-protected Redis.
# REDIS_PASSWORD=
