# Copy to .env (git-ignored) before the first start. Dev-only default:
# the app reads it as DB_PASSWORD, the db service initializes PostgreSQL
# with it. Change it for anything beyond local development.
DB_PASSWORD=mandat

# Not used by the local Compose stack: its Redis has no password and Compose
# does not forward this variable to the app service. Keep it for deployments
# that run the app directly against a password-protected Redis.
# REDIS_PASSWORD=

# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: Cloudflare R2 API token pair.
# Never commit real values; export them in the environment or keep them in
# the git-ignored .env file. Optionally set R2_ACCOUNT_ID to derive the
# endpoint as https://<account>.r2.cloudflarestorage.com.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# R2_ENDPOINT / R2_BUCKET / R2_PUBLIC_BASE_URL override the matching
# config.yaml storage.* values when set (handy for Compose).
# R2_ENDPOINT=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
